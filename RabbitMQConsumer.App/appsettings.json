{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "RabbitMQConsumer-dotnet"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/rabbitmqconsumer-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "shared": false,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "RabbitMQOptions": {
    "Name": "RabbitMQOptions_Name",
    "Host": "RabbitMQOptions_Host",
    "User": "RabbitMQOptions_User",
    "Pwd": "RabbitMQOptions_Pwd"
  },
  "UrlOptions": {
    "PublisherApi": {
      "MarkAsProcessed": "UrlOptions_PublisherApi_MarkAsProcessed",
      "AddErrorMessage": "UrlOptions_PublisherApi_AddErrorMessage"
    }
  }
}